{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Floatspace",
    "version": "0.1.0",
    "identifier": "com.floatspace.app",
    
    "build": {
      "beforeDevCommand": "npm run dev -- --port 1423",
      "devUrl": "http://127.0.0.1:1423",
      "beforeBuildCommand": "npm run build && ./scripts/bundle-spotlight.sh",
      "frontendDist": "../dist"
    },
    
    "app": {
        "macOSPrivateApi": true,
        
        "windows": [
            {
                "title": "Floatspace",
                "width": 800,
                "height": 600,
                "resizable": true,
                "decorations": false,
                "transparent": true,
                "shadow": false,
                "visible": false,
                "maximized": false,
                "fullscreen": false
            }
        ],
        
        "security": {
            "csp": null
        }
    },
    
    "plugins": {
      "deep-link": {
        "desktop": {
          "schemes": ["floatspace"]
        }
      }
    },
    
    "bundle": {
      "active": true,

      "targets": [
        "app",
        "dmg"
      ],

      "macOS": {
        "minimumSystemVersion": "14.0",
        "signingIdentity": "Apple Development: alxxeu@proton.me (98WKTQM42F)",

        "frameworks": [
          "native/libFloatspaceSpotlightBridge.dylib"
        ]
      }
    }
}
